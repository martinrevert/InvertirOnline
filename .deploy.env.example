# Copia este archivo como .deploy.env y completa tus datos locales.
# .deploy.env está ignorado en .gitignore para nunca subir credenciales al repositorio.

# Método de despliegue: "samba" o "ssh"
DEPLOY_METHOD=samba

# Configuración Samba (Windows UNC)
SAMBA_HOST=192.168.86.28
SAMBA_SHARE=config
SAMBA_USER=homeassistant
SAMBA_PASS=homeassistant

# Configuración SSH (alternativa si DEPLOY_METHOD=ssh)
SSH_TARGET=root@192.168.86.28
SSH_CONFIG_PATH=/config

# Opcional: Recarga automática vía API REST de Home Assistant
# HA_URL=http://192.168.86.28:8123
# HA_TOKEN=tu_long_lived_access_token
